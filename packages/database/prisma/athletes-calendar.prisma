enum AthletesCalendarRsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

model AthletesCalendarEntry {
  id                   String   @id
  /// Canonical AthletesCommunity id. The governed migration enforces the foreign key.
  athletesCommunityId  String
  title                String
  description          String?
  /// Founder-entered event address / meeting place.
  location             String?
  /// External event-photo URL. Mutually exclusive with uploaded media fields.
  photoUrl              String?
  /// Opaque identifier for a Calendar-owned uploaded event photo.
  photoMediaId          String?  @unique
  /// Private object-storage key for uploaded Calendar event media. Never exposed by the API.
  photoObjectKey        String?  @unique
  /// Optimized uploaded media content type. Internal storage metadata only.
  photoContentType      String?
  /// Optimized uploaded media size. Internal storage metadata only.
  photoSizeBytes        Int?
  startsAt             DateTime
  endsAt               DateTime
  timezone             String
  cancelledAt          DateTime?
  /// Canonical User id of the Founder who created the entry. The governed migration enforces the foreign key.
  createdByUserId      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([athletesCommunityId, startsAt, id])
  @@index([athletesCommunityId, cancelledAt, startsAt])
}

model AthletesCalendarRsvp {
  id              String                     @id
  /// Canonical AthletesCalendarEntry id. The governed migration enforces the foreign key.
  calendarEntryId String
  /// Canonical User id of the responding member. The governed migration enforces the foreign key.
  userId          String
  status          AthletesCalendarRsvpStatus
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([calendarEntryId, userId])
  @@index([calendarEntryId, status])
  @@index([userId])
}
