generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  PLATFORM_ADMIN
}

enum AppManagerCapability {
  REVIEW_PITCH_APPLICATIONS
  VIEW_AUDIT
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlaceSubmissionOrigin {
  OWNER
  FANHUB
}

enum PlaceCapabilityKind {
  PITCH
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum CommunityStatus {
  ACTIVE
  ARCHIVED
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityJoinPolicy {
  OPEN
  APPROVAL_REQUIRED
}

enum CommunityJoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum CommunityRole {
  FOUNDER
  COACH
  MEMBER
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum AthletesSport {
  CYCLING
  RUNNING
  SWIMMING
  FOOTBALL
  BASKETBALL
  TENNIS
  PADEL
  GYM_FITNESS
  OTHER
}

enum AthletesCommunityStatus {
  ACTIVE
  ARCHIVED
}

enum AthletesVisibility {
  PUBLIC
  PRIVATE
}

enum AthletesJoinPolicy {
  OPEN
  APPROVAL_REQUIRED
}

enum AthletesRole {
  FOUNDER
  MODERATOR
  MEMBER
}

enum AthletesJoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum TeamResponsibilityRole {
  COACH
  ASSISTANT
}

enum TeamCapability {
  EDIT_TEAM
  MANAGE_ROSTER
  MANAGE_LINEUP
  CREATE_CHALLENGE
  RESPOND_TO_CHALLENGE
  MANAGE_TEAM_EVENTS
}

enum TeamPlayerOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TeamChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum TeamGameStatus {
  SCHEDULING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum FootballFormat {
  FIVE_V_FIVE
  SIX_V_SIX
  SEVEN_V_SEVEN
  EIGHT_V_EIGHT
  NINE_V_NINE
  ELEVEN_V_ELEVEN
}

enum EventType {
  PLAY
  WATCH
}

enum EventStatus {
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum EventRsvpStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum EventPlayerInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  MIXED
}

enum PlayPitchType {
  FIVE_A_SIDE
  SEVEN_A_SIDE
  ELEVEN_A_SIDE
  FUTSAL
  STREET
  OTHER
}

enum PlayEventVisibility {
  OPEN
  PRIVATE
}

enum EventTeamSide {
  A
  B
}

enum WhistleContextType {
  COMMUNITY
  EVENT
  TEAM
  RIDE
  ULTRAS
  GAMER_SQUAD
  GAMER_DIRECT
  USER_DIRECT
}

enum RideOfferStatus {
  OPEN
  FULL
  DEPARTED
  CANCELLED
  COMPLETED
}

enum RideRequestStatus {
  OPEN
  MATCHED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum RideRequestAudienceScope {
  GLOBAL
  COMMUNITY
}

enum RideParticipationStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

enum RideContext {
  MATCHDAY
  GENERAL
}

enum RideCompensationType {
  FREE
  CASH
}

enum RideCompensationBasis {
  PER_SEAT
  TOTAL
}

enum GamerGameStatus {
  ACTIVE
  INACTIVE
}

enum GamerChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum PlayLookingFor {
  GAME
  TEAM
}

enum ProfileIdentity {
  PLAYER
  FAN
  GAMER
}

model User {
  id                            String                         @id @default(cuid())
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  identities                    ProfileIdentity[]              @default([])
  presentation                  UserPresentation?
  playerProfile                 PlayerProfile?
  telegramIdentity              TelegramIdentity?
  webCredential                 WebCredential?
  webSessions                   WebSession[]
  platformRoles                 PlatformRoleAssignment[]
  appManagerGrants              AppManagerGrant[]              @relation("AppManagerRecipient")
  appManagerGrantsGiven         AppManagerGrant[]              @relation("AppManagerGrantor")
  auditEntries                  AuditLog[]                     @relation("AuditActor")
  communitiesCreated            Community[]                    @relation("CommunityCreator")
  communityMemberships          CommunityMembership[]
  communityJoinRequests         CommunityJoinRequest[]         @relation("CommunityJoinRequester")
  communityJoinRequestsResolved CommunityJoinRequest[]         @relation("CommunityJoinResolver")
  athletesCommunitiesCreated    AthletesCommunity[]            @relation("AthletesCommunityCreator")
  athletesMemberships           AthletesMembership[]
  athletesJoinRequests          AthletesJoinRequest[]           @relation("AthletesJoinRequester")
  athletesJoinRequestsResolved  AthletesJoinRequest[]           @relation("AthletesJoinResolver")
  teamsCreated                  Team[]                         @relation("TeamCreator")
  teamPlayers                   TeamPlayer[]
  teamOffersReceived            TeamPlayerOffer[]              @relation("TeamOfferTarget")
  teamOffersSent                TeamPlayerOffer[]              @relation("TeamOfferSender")
  teamResponsibilities          TeamResponsibilityAssignment[]
  teamCapabilityGrants          TeamCapabilityGrant[]          @relation("CapabilityRecipient")
  teamCapabilityGrantsGiven     TeamCapabilityGrant[]          @relation("CapabilityGrantor")
  teamLineupsCreated            TeamLineup[]                   @relation("LineupCreator")
  teamChallengesCreated         TeamChallenge[]                @relation("ChallengeCreator")
  teamChallengeMessages         TeamChallengeMessage[]
  eventsCreated                 Event[]                        @relation("EventCreator")
  eventRsvps                    EventRsvp[]
  eventInvitesReceived          EventPlayerInvite[]            @relation("EventInviteTarget")
  eventInvitesSent              EventPlayerInvite[]            @relation("EventInviteSender")
  eventFormationsCreated        Formation[]                    @relation("FormationCreator")
  formationSlots                FormationSlot[]
  eventCheckIns                 EventCheckIn[]
  eventChatMessages             EventChatMessage[]
  rideOffersDriven              RideOffer[]                    @relation("RideOfferDriver")
  rideRequestsCreated           RideRequest[]                  @relation("RideRequestRequester")
  rideParticipations            RideParticipation[]            @relation("RideParticipationPassenger")
  whistlesAuthored              WhistleMetadata[]
  gamerGamesCreated             GamerGame[]                    @relation("GamerGameCreator")
  gamerProfiles                 GamerProfile[]
  playPlayerListings            PlayPlayerListing[]
  placesSuggested               Place[]                        @relation("PlaceSuggester")
  placeOwnershipClaims          PlaceOwnershipClaim[]          @relation("PlaceClaimant")
  placeOwnerships               PlaceOwnership[]               @relation("PlaceOwner")
  placeCapabilityApplications   PlaceCapabilityApplication[]   @relation("PlaceCapabilityApplicant")
}

model UserPresentation {
  userId      String   @id
  username    String   @unique
  displayName String
  photoUrl    String?
  bio         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlayerProfile {
  userId             String     @id
  skillLevel         SkillLevel
  preferredPositions String[]
  overallRating      Int        @default(50)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramIdentity {
  userId              String   @id
  telegramUserId      BigInt   @unique
  telegramUsername    String?
  firstName           String?
  lastName            String?
  photoUrl            String?
  languageCode        String?
  isPremium           Boolean  @default(false)
  lastAuthenticatedAt DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebCredential {
  userId           String    @id
  loginUsername    String    @unique
  passwordHash     String
  email            String?   @unique
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model PlatformRoleAssignment {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  grantedAt DateTime     @default(now())
  grantedBy String?
  revokedAt DateTime?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, revokedAt])
}

model AppManagerGrant {
  id              String               @id @default(cuid())
  userId          String
  capability      AppManagerCapability
  grantedByUserId String
  grantedAt       DateTime             @default(now())
  revokedAt       DateTime?
  user            User                 @relation("AppManagerRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy       User                 @relation("AppManagerGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@unique([userId, capability])
  @@index([userId, revokedAt])
  @@index([capability, revokedAt])
}

model Place {
  id                  String                       @id @default(cuid())
  slug                String                       @unique
  name                String
  address             String
  city                String?
  houma                String?
  latitude            Decimal?                     @db.Decimal(10, 7)
  longitude           Decimal?                     @db.Decimal(10, 7)
  phone               String?
  email               String?
  websiteUrl          String?
  imageUrl            String?
  category            String?
  description         String?
  moderationStatus    ModerationStatus             @default(PENDING)
  submissionOrigin    PlaceSubmissionOrigin?
  suggestedByUserId   String
  reviewedByUserId    String?
  reviewedAt          DateTime?
  reviewNote          String?
  archivedAt          DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  suggestedBy         User                         @relation("PlaceSuggester", fields: [suggestedByUserId], references: [id], onDelete: Restrict)
  ownershipClaims     PlaceOwnershipClaim[]
  ownerships          PlaceOwnership[]
  capabilities        PlaceCapability[]
  applications        PlaceCapabilityApplication[]
  menuItems           PlaceMenuItem[]
  images              PlaceImage[]
  events              Event[]
  teamChallengeVenues TeamChallenge[]              @relation("TeamChallengePlace")
  teamGameVenues      TeamGame[]                   @relation("TeamGamePlace")
  rideOfferDestinations RideOffer[]                @relation("RideOfferDestinationPlace")
  rideRequestDestinations RideRequest[]            @relation("RideRequestDestinationPlace")
  rideOfferWaypoints  RideOfferWaypoint[]          @relation("RideOfferWaypointPlace")

  @@index([moderationStatus, archivedAt, createdAt])
  @@index([submissionOrigin, moderationStatus, archivedAt])
  @@index([city, houma])
}

model PlaceMenuItem {
  id        String   @id @default(cuid())
  placeId   String
  name      String
  price     Decimal  @db.Decimal(10, 3)
  currency  String   @default("TND")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, sortOrder])
}

model PlaceImage {
  id        String   @id @default(cuid())
  placeId   String
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, sortOrder])
  @@index([placeId, sortOrder])
}

model PlaceOwnershipClaim {
  id               String           @id @default(cuid())
  placeId          String
  claimantUserId   String
  evidence         String
  status           ModerationStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  place            Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  claimant         User             @relation("PlaceClaimant", fields: [claimantUserId], references: [id], onDelete: Cascade)

  @@unique([placeId, claimantUserId])
  @@index([status, createdAt])
  @@index([claimantUserId, status])
}

model PlaceOwnership {
  id               String   @id @default(cuid())
  placeId          String
  userId           String
  verifiedByUserId String
  verifiedAt       DateTime @default(now())
  revokedAt        DateTime?
  place            Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user             User     @relation("PlaceOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([placeId, userId])
  @@index([userId, revokedAt])
  @@index([placeId, revokedAt])
}

model PlaceCapability {
  id               String              @id @default(cuid())
  placeId          String
  kind             PlaceCapabilityKind
  status           ModerationStatus    @default(PENDING)
  summary          String?
  hourlyRateMinor  Int?
  currency         String?             @db.VarChar(3)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  place            Place               @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, kind])
  @@index([kind, status, updatedAt])
}

model PlaceCapabilityApplication {
  id               String              @id @default(cuid())
  placeId          String
  applicantUserId  String
  kind             PlaceCapabilityKind
  summary          String
  hourlyRateMinor  Int?
  currency         String?             @db.VarChar(3)
  status           ModerationStatus    @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  place            Place               @relation(fields: [placeId], references: [id], onDelete: Cascade)
  applicant        User                @relation("PlaceCapabilityApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)

  @@index([kind, status, createdAt])
  @@index([applicantUserId, status])
}

model Community {
  id              String                      @id @default(cuid())
  slug            String                      @unique
  name            String
  description     String?
  city            String?
  houma            String?
  logoUrl         String?
  bannerUrl       String?
  status          CommunityStatus             @default(ACTIVE)
  visibility      CommunityVisibility         @default(PUBLIC)
  joinPolicy      CommunityJoinPolicy         @default(OPEN)
  createdByUserId String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  createdBy       User                        @relation("CommunityCreator", fields: [createdByUserId], references: [id])
  memberships     CommunityMembership[]
  joinRequests    CommunityJoinRequest[]
  teams           Team[]
  events          Event[]
  rideRequestAudiences RideRequestCommunityAudience[]

  @@index([status, visibility, createdAt])
  @@index([city, houma])
}

model CommunityMembership {
  id          String        @id @default(cuid())
  communityId String
  userId      String
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  leftAt      DateTime?
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId, role, leftAt])
}

model CommunityJoinRequest {
  id               String                     @id @default(cuid())
  communityId      String
  userId           String
  status           CommunityJoinRequestStatus @default(PENDING)
  requestedAt      DateTime                   @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  updatedAt        DateTime                   @updatedAt
  community        Community                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  requester        User                       @relation("CommunityJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy       User?                      @relation("CommunityJoinResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([communityId, userId])
  @@index([communityId, status, requestedAt])
  @@index([userId, status, requestedAt])
}


model AthletesCommunity {
  id              String                   @id @default(cuid())
  slug            String                   @unique
  name            String
  sport           AthletesSport
  description     String?
  city            String?
  houma           String?
  logoUrl         String?
  bannerUrl       String?
  visibility      AthletesVisibility       @default(PUBLIC)
  joinPolicy      AthletesJoinPolicy       @default(OPEN)
  status          AthletesCommunityStatus  @default(ACTIVE)
  createdByUserId String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  createdBy       User                     @relation("AthletesCommunityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships     AthletesMembership[]
  joinRequests    AthletesJoinRequest[]

  @@index([status, sport, createdAt, id])
  @@index([city, houma])
  @@index([createdByUserId, status])
}

model AthletesMembership {
  id                   String             @id @default(cuid())
  athletesCommunityId  String
  userId               String
  role                 AthletesRole       @default(MEMBER)
  joinedAt             DateTime           @default(now())
  leftAt               DateTime?
  athletesCommunity    AthletesCommunity  @relation(fields: [athletesCommunityId], references: [id], onDelete: Cascade)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([athletesCommunityId, userId, leftAt])
  @@index([userId, role, leftAt])
  @@index([athletesCommunityId, role, leftAt])
}

model AthletesJoinRequest {
  id                   String                     @id @default(cuid())
  athletesCommunityId  String
  userId               String
  status               AthletesJoinRequestStatus  @default(PENDING)
  requestedAt          DateTime                   @default(now())
  resolvedAt           DateTime?
  resolvedByUserId     String?
  updatedAt            DateTime                   @updatedAt
  athletesCommunity    AthletesCommunity          @relation(fields: [athletesCommunityId], references: [id], onDelete: Cascade)
  requester            User                       @relation("AthletesJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy           User?                      @relation("AthletesJoinResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([athletesCommunityId, status, requestedAt])
  @@index([userId, status, requestedAt])
}

model Team {
  id                   String                         @id @default(cuid())
  communityId          String?
  slug                 String                         @unique
  name                 String
  motto                String?
  city                 String?
  houma                String?
  badgeUrl             String?
  bannerUrl            String?
  status               TeamStatus                     @default(ACTIVE)
  createdByUserId      String
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  community            Community?                     @relation(fields: [communityId], references: [id], onDelete: SetNull)
  createdBy            User                           @relation("TeamCreator", fields: [createdByUserId], references: [id])
  players              TeamPlayer[]
  playerOffers         TeamPlayerOffer[]
  responsibilities     TeamResponsibilityAssignment[]
  capabilityGrants     TeamCapabilityGrant[]
  lineups              TeamLineup[]
  challengesSent       TeamChallenge[]                @relation("ChallengeChallenger")
  challengesReceived   TeamChallenge[]                @relation("ChallengeChallenged")
  homeGames            TeamGame[]                     @relation("GameHomeTeam")
  awayGames            TeamGame[]                     @relation("GameAwayTeam")

  @@index([status, createdAt])
  @@index([communityId, status])
  @@index([city, houma])
}

model TeamPlayer {
  id          String           @id @default(cuid())
  teamId      String
  userId      String
  number      Int?
  positions   String[]
  active      Boolean          @default(true)
  joinedAt    DateTime         @default(now())
  leftAt      DateTime?
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineupSlots TeamLineupSlot[]

  @@unique([teamId, userId])
  @@index([teamId, active])
  @@index([userId, active])
}

model TeamPlayerOffer {
  id              String                @id @default(cuid())
  teamId          String
  targetUserId    String
  offeredByUserId String
  message         String?
  status          TeamPlayerOfferStatus @default(PENDING)
  createdAt       DateTime              @default(now())
  respondedAt     DateTime?
  updatedAt       DateTime              @updatedAt
  team            Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  targetUser      User                  @relation("TeamOfferTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  offeredBy       User                  @relation("TeamOfferSender", fields: [offeredByUserId], references: [id], onDelete: Restrict)

  @@unique([teamId, targetUserId])
  @@index([targetUserId, status, createdAt])
  @@index([teamId, status, createdAt])
}

model TeamResponsibilityAssignment {
  id        String                 @id @default(cuid())
  teamId    String
  userId    String
  role      TeamResponsibilityRole
  createdAt DateTime               @default(now())
  revokedAt DateTime?
  team      Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId, role, revokedAt])
  @@index([userId, role, revokedAt])
}

model TeamCapabilityGrant {
  id         String         @id @default(cuid())
  teamId     String
  userId     String
  capability TeamCapability
  grantedBy  String
  createdAt  DateTime       @default(now())
  revokedAt  DateTime?
  team       Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User           @relation("CapabilityRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantor    User           @relation("CapabilityGrantor", fields: [grantedBy], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, capability])
  @@index([teamId, userId, revokedAt])
}

model TeamLineup {
  id              String           @id @default(cuid())
  teamId          String
  createdByUserId String
  name            String
  formation       String
  matchFormat     FootballFormat
  published       Boolean          @default(false)
  isCurrent       Boolean          @default(false)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("LineupCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  slots           TeamLineupSlot[]

  @@index([teamId, published, active, updatedAt])
  @@index([teamId, isCurrent, active])
}

model TeamLineupSlot {
  id           String      @id @default(cuid())
  lineupId     String
  teamPlayerId String?
  position     String
  x            Float       @default(50)
  y            Float       @default(50)
  isStarter    Boolean     @default(true)
  sortOrder    Int         @default(0)
  lineup       TeamLineup  @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  teamPlayer   TeamPlayer? @relation(fields: [teamPlayerId], references: [id], onDelete: SetNull)

  @@index([lineupId, sortOrder])
  @@index([teamPlayerId])
}

model TeamChallenge {
  id               String              @id @default(cuid())
  challengerTeamId String
  challengedTeamId String
  createdByUserId  String
  format           FootballFormat
  proposedAt       DateTime?
  proposedEndsAt   DateTime?
  placeId          String?
  venueName        String?
  address           String?
  message          String?
  status           TeamChallengeStatus @default(PENDING)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  challengerTeam   Team                @relation("ChallengeChallenger", fields: [challengerTeamId], references: [id], onDelete: Cascade)
  challengedTeam   Team                @relation("ChallengeChallenged", fields: [challengedTeamId], references: [id], onDelete: Cascade)
  createdBy        User                @relation("ChallengeCreator", fields: [createdByUserId], references: [id])
  place            Place?              @relation("TeamChallengePlace", fields: [placeId], references: [id], onDelete: Restrict)
  messages         TeamChallengeMessage[]
  game             TeamGame?

  @@index([challengerTeamId, status, createdAt])
  @@index([challengedTeamId, status, createdAt])
  @@index([placeId, status, createdAt])
}

model TeamChallengeMessage {
  id           String        @id @default(cuid())
  challengeId  String
  authorUserId String
  body         String
  createdAt    DateTime      @default(now())
  challenge    TeamChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([challengeId, createdAt])
}

model TeamGame {
  id          String         @id @default(cuid())
  challengeId String         @unique
  homeTeamId  String
  awayTeamId  String
  scheduledAt DateTime?
  endsAt      DateTime?
  placeId     String?
  venueName   String?
  address     String?
  status      TeamGameStatus @default(SCHEDULING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  challenge   TeamChallenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  homeTeam    Team           @relation("GameHomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam    Team           @relation("GameAwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  place       Place?         @relation("TeamGamePlace", fields: [placeId], references: [id], onDelete: Restrict)

  @@index([homeTeamId, scheduledAt])
  @@index([awayTeamId, scheduledAt])
  @@index([placeId, scheduledAt])
}

model Event {
  id              String             @id @default(cuid())
  communityId     String?
  placeId         String?
  createdByUserId String
  type            EventType
  status          EventStatus        @default(PUBLISHED)
  title           String
  description     String?
  startsAt        DateTime
  endsAt          DateTime?
  timezone        String             @default("Africa/Tunis")
  venueName       String?
  address         String?
  capacity        Int?
  waitlistEnabled Boolean            @default(true)
  entryFeeMinor   BigInt             @default(0)
  currency        String             @default("TND")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  community       Community?         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  place           Place?             @relation(fields: [placeId], references: [id], onDelete: Restrict)
  createdBy       User               @relation("EventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  playDetails     PlayEventDetails?
  watchDetails    WatchEventDetails?
  rsvps           EventRsvp[]
  playerInvites   EventPlayerInvite[]
  formations      Formation[]
  checkIns        EventCheckIn[]
  chatRoom        EventChatRoom?
  rideOffers      RideOffer[]      @relation("RideOfferDestinationEvent")
  rideRequests    RideRequest[]    @relation("RideRequestDestinationEvent")

  @@index([type, status, startsAt, id])
  @@index([communityId, type, status, startsAt])
  @@index([placeId, type, status, startsAt])
  @@index([createdByUserId])
}

model PlayEventDetails {
  eventId    String              @id
  pitchType  PlayPitchType
  skillLevel SkillLevel          @default(MIXED)
  format     FootballFormat
  visibility PlayEventVisibility @default(OPEN)
  event      Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model WatchEventDetails {
  eventId        String @id
  teamOneName    String
  teamOneLogoUrl String?
  teamTwoName    String
  teamTwoLogoUrl String?
  event          Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventRsvp {
  id               String          @id @default(cuid())
  eventId          String
  userId           String
  status           EventRsvpStatus @default(CONFIRMED)
  waitlistSequence BigInt?
  checkedInAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  event            Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status, waitlistSequence])
  @@index([userId, status])
}

model EventPlayerInvite {
  id              String                  @id @default(cuid())
  eventId         String
  targetUserId    String
  invitedByUserId String
  status          EventPlayerInviteStatus @default(PENDING)
  createdAt       DateTime                @default(now())
  respondedAt     DateTime?
  updatedAt       DateTime                @updatedAt
  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  targetUser      User                    @relation("EventInviteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  invitedBy       User                    @relation("EventInviteSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([eventId, targetUserId])
  @@index([targetUserId, status, createdAt])
  @@index([eventId, status, createdAt])
  @@index([invitedByUserId, status, createdAt])
}

model Formation {
  id              String          @id @default(cuid())
  eventId         String
  createdByUserId String
  name            String
  format          FootballFormat
  published       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy       User            @relation("FormationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  slots           FormationSlot[]

  @@index([eventId, updatedAt])
}

model FormationSlot {
  id          String        @id @default(cuid())
  formationId String
  userId      String?
  team        EventTeamSide
  position    String
  label       String
  x           Float
  y           Float
  formation   Formation     @relation(fields: [formationId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([formationId, team])
  @@index([userId])
}

model EventCheckIn {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model EventChatRoom {
  id        String             @id @default(cuid())
  eventId   String             @unique
  opensAt   DateTime
  closesAt  DateTime
  createdAt DateTime           @default(now())
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messages  EventChatMessage[]

  @@index([closesAt])
}

model EventChatMessage {
  id        String        @id @default(cuid())
  roomId    String
  userId    String
  body      String
  createdAt DateTime      @default(now())
  expiresAt DateTime
  room      EventChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt, id])
  @@index([expiresAt])
}

model RideOffer {
  id                     String                  @id @default(cuid())
  driverUserId           String
  context                RideContext             @default(MATCHDAY)
  eventId                String?
  destinationPlaceId     String?
  customDestinationLabel String?
  originAreaLabel        String
  departureAt            DateTime
  totalSeats             Int
  compensationType       RideCompensationType     @default(FREE)
  compensationAmountMinor Int?
  compensationCurrency   String?                 @db.VarChar(3)
  compensationBasis      RideCompensationBasis?
  vehicleMake            String?
  vehicleModel           String?
  vehicleColor           String?
  note                   String?
  status                 RideOfferStatus         @default(OPEN)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  driver                 User                    @relation("RideOfferDriver", fields: [driverUserId], references: [id], onDelete: Cascade)
  destinationEvent       Event?                  @relation("RideOfferDestinationEvent", fields: [eventId], references: [id], onDelete: Restrict)
  destinationPlace       Place?                  @relation("RideOfferDestinationPlace", fields: [destinationPlaceId], references: [id], onDelete: Restrict)
  participations         RideParticipation[]
  waypoints              RideOfferWaypoint[]
  vehiclePhoto           RideOfferVehiclePhoto?

  @@index([status, departureAt, id])
  @@index([context, status, departureAt, id])
  @@index([driverUserId, status, departureAt])
  @@index([eventId, status, departureAt])
  @@index([destinationPlaceId, status, departureAt])
}

model RideOfferVehiclePhoto {
  id          String    @id
  rideOfferId String    @unique
  objectKey   String    @unique
  contentType String
  sizeBytes   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  rideOffer   RideOffer @relation(fields: [rideOfferId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model RideRequest {
  id                     String            @id @default(cuid())
  requesterUserId        String
  context                RideContext       @default(MATCHDAY)
  eventId                String?
  destinationPlaceId     String?
  customDestinationLabel String?
  pickupAreaLabel        String
  desiredDepartureAt     DateTime
  passengerCount         Int
  compensationType       RideCompensationType @default(FREE)
  compensationAmountMinor Int?
  compensationCurrency   String?           @db.VarChar(3)
  compensationBasis      RideCompensationBasis?
  note                   String?
  expiresAt              DateTime
  audienceScope          RideRequestAudienceScope @default(GLOBAL)
  status                 RideRequestStatus @default(OPEN)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  requester              User              @relation("RideRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  destinationEvent       Event?            @relation("RideRequestDestinationEvent", fields: [eventId], references: [id], onDelete: Restrict)
  destinationPlace       Place?            @relation("RideRequestDestinationPlace", fields: [destinationPlaceId], references: [id], onDelete: Restrict)
  communityAudiences     RideRequestCommunityAudience[]

  @@index([audienceScope, status, expiresAt])
  @@index([context, status, desiredDepartureAt, id])
  @@index([requesterUserId, status, createdAt])
  @@index([eventId, status, desiredDepartureAt])
  @@index([destinationPlaceId, status, desiredDepartureAt])
  @@index([expiresAt, status])
}

model RideRequestCommunityAudience {
  rideRequestId String
  communityId   String
  createdAt     DateTime @default(now())
  rideRequest   RideRequest @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)
  community     Community   @relation(fields: [communityId], references: [id], onDelete: Restrict)

  @@id([rideRequestId, communityId])
  @@index([communityId, rideRequestId])
}

model RideParticipation {
  id              String                  @id @default(cuid())
  rideOfferId     String
  passengerUserId String
  seatCount       Int
  status          RideParticipationStatus @default(REQUESTED)
  requestedAt     DateTime                @default(now())
  respondedAt     DateTime?
  cancelledAt     DateTime?
  completedAt     DateTime?
  rideOffer       RideOffer               @relation(fields: [rideOfferId], references: [id], onDelete: Cascade)
  passenger       User                    @relation("RideParticipationPassenger", fields: [passengerUserId], references: [id], onDelete: Cascade)
  meetingPoint    RideMeetingPoint?

  @@unique([rideOfferId, passengerUserId])
  @@index([rideOfferId, status, requestedAt])
  @@index([passengerUserId, status, requestedAt])
}

model RideMeetingPoint {
  id              String            @id @default(cuid())
  participationId String            @unique
  label           String
  latitude        Decimal?          @db.Decimal(10, 7)
  longitude       Decimal?          @db.Decimal(10, 7)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  participation   RideParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
}

model RideOfferWaypoint {
  id          String    @id @default(cuid())
  rideOfferId String
  sequence    Int
  placeId     String?
  areaLabel   String
  rideOffer   RideOffer @relation(fields: [rideOfferId], references: [id], onDelete: Cascade)
  place       Place?    @relation("RideOfferWaypointPlace", fields: [placeId], references: [id], onDelete: Restrict)

  @@unique([rideOfferId, sequence])
  @@index([rideOfferId, sequence])
  @@index([placeId])
}

model WhistleMetadata {
  id           String             @id
  authorUserId String
  contextType  WhistleContextType
  contextId    String
  createdAt    DateTime           @default(now())
  expiresAt    DateTime
  author       User               @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([contextType, contextId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([expiresAt])
}

model GamerGame {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  normalizedName  String          @unique
  status          GamerGameStatus @default(ACTIVE)
  createdByUserId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       User?           @relation("GamerGameCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  profiles        GamerProfile[]
  challenges      GamerChallenge[]

  @@index([status, name])
  @@index([createdByUserId, createdAt])
}

model GamerProfile {
  id                 String           @id @default(cuid())
  userId             String
  gameId             String
  handle             String
  openToChallenge    Boolean
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  game               GamerGame        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  challengesSent     GamerChallenge[] @relation("GamerChallengeChallenger")
  challengesReceived GamerChallenge[] @relation("GamerChallengeChallenged")

  @@unique([userId, gameId])
  @@index([gameId, openToChallenge, updatedAt])
}

model GamerChallenge {
  id                  String               @id @default(cuid())
  gameId              String
  challengerProfileId String
  challengedProfileId String
  pairKey             String
  status              GamerChallengeStatus @default(PENDING)
  createdAt           DateTime             @default(now())
  respondedAt         DateTime?
  cancelledAt         DateTime?
  updatedAt           DateTime             @updatedAt
  game                GamerGame            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  challengerProfile   GamerProfile         @relation("GamerChallengeChallenger", fields: [challengerProfileId], references: [id], onDelete: Cascade)
  challengedProfile   GamerProfile         @relation("GamerChallengeChallenged", fields: [challengedProfileId], references: [id], onDelete: Cascade)

  @@index([gameId, status, createdAt])
  @@index([challengerProfileId, status, createdAt])
  @@index([challengedProfileId, status, createdAt])
  @@index([gameId, pairKey, status])
}

model PlayPlayerListing {
  id         String         @id @default(cuid())
  userId     String         @unique
  lookingFor PlayLookingFor
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lookingFor, updatedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  topic         String
  aggregateType String?
  aggregateId   String?
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  claimedAt     DateTime?
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}
