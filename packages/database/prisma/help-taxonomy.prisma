enum HelpTaxonomyNeedKind {
  PRODUCT
  COMMUNITY_ROLE
  COMMUNITY_SUPPORT
}

enum HelpTaxonomySurface {
  REQUESTS
  PLAY
  ATHLETES
  DONATIONS
}

/// Root discriminator of the shared Requests taxonomy.
/// SPORT subcategories belong to an AthletesSport; COMMUNITY subcategories do not.
enum HelpRequestType {
  SPORT
  COMMUNITY
}

model HelpTaxonomySubcategory {
  id          String          @id
  requestType HelpRequestType @default(SPORT)
  sport       AthletesSport?
  slug        String
  label       String
  sortOrder   Int
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  needs        HelpTaxonomyNeed[]
  helpRequests HelpRequest[] @relation("HelpRequestTaxonomySubcategory")
  helpRequestTypes HelpRequest[] @relation("HelpRequestTaxonomySubcategoryType")

  @@unique([sport, slug])
  @@unique([id, sport])
  @@unique([id, requestType])
  @@index([requestType, sport, active, sortOrder])
}

model HelpTaxonomyNeed {
  id               String                    @id
  subcategoryId    String
  slug             String
  label            String
  kind             HelpTaxonomyNeedKind
  allowsCustomText Boolean                   @default(false)
  sortOrder        Int
  active           Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  subcategory      HelpTaxonomySubcategory   @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  surfaces         HelpTaxonomyNeedSurface[]
  helpRequests     HelpRequest[] @relation("HelpRequestTaxonomyNeed")

  @@unique([subcategoryId, slug])
  @@unique([id, subcategoryId])
  @@index([subcategoryId, active, sortOrder])
  @@index([kind, active])
}

model HelpTaxonomyNeedSurface {
  needId  String
  surface HelpTaxonomySurface
  need    HelpTaxonomyNeed    @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@id([needId, surface])
  @@index([surface, needId])
}
