enum HelpTaxonomyNeedKind {
  PRODUCT
  COMMUNITY_ROLE
  COMMUNITY_SUPPORT
}

enum HelpTaxonomySurface {
  REQUESTS
  PLAY
  ATHLETES
  DONATIONS
}

model HelpTaxonomySubcategory {
  id        String         @id
  sport     AthletesSport
  slug      String
  label     String
  sortOrder Int
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  needs     HelpTaxonomyNeed[]

  @@unique([sport, slug])
  @@index([sport, active, sortOrder])
}

model HelpTaxonomyNeed {
  id               String                    @id
  subcategoryId    String
  slug             String
  label            String
  kind             HelpTaxonomyNeedKind
  allowsCustomText Boolean                   @default(false)
  sortOrder        Int
  active           Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  subcategory      HelpTaxonomySubcategory   @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  surfaces         HelpTaxonomyNeedSurface[]

  @@unique([subcategoryId, slug])
  @@index([subcategoryId, active, sortOrder])
  @@index([kind, active])
}

model HelpTaxonomyNeedSurface {
  needId  String
  surface HelpTaxonomySurface
  need    HelpTaxonomyNeed    @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@id([needId, surface])
  @@index([surface, needId])
}
