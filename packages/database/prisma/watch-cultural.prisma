enum WatchCulturalCategory {
  MUSIC
  CONCERT
  COMEDY
  ART
  SCREENING
  FOOD
  COMMUNITY
  OTHER
}

model WatchCulturalEventDetails {
  eventId             String                @id
  culturalCategory    WatchCulturalCategory
  imageUrl            String?
}

model PlaceImage {
  id        String   @id @default(cuid())
  placeId   String
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([placeId, sortOrder])
  @@index([placeId, sortOrder])
}
