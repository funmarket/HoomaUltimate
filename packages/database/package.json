{
  "name": "@hooma/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate --schema prisma",
    "validate": "prisma validate --schema prisma",
    "migrate:dev": "prisma migrate dev --schema prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma",
    "migrate:status": "prisma migrate status --schema prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "5.9.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  }
}
