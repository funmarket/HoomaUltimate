{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo legacy-telegram-redirect"
  },
  "deploy": {
    "startCommand": "node scripts/redirect-legacy-telegram.mjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
