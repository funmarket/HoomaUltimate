{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run db:generate && npm run build:packages && npm -w @hooma/web run build"
  },
  "deploy": {
    "startCommand": "node scripts/serve-static.mjs apps/web/dist",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
